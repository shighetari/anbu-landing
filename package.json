{
  "name": "anbu-landing",
  "private": true,
  "version": "1.0.0",
  "description": "ANBU Solutions Landing Page - Monorepo",
  "author": "ANBU Solutions",
  "license": "PROPRIETARY",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mdx,css,scss}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mdx,css,scss}\"",
    "commit": "cz",
    "clean": "turbo clean && rimraf node_modules",
    "clean:all": "rimraf \"**/node_modules\" \"**/.next\" \"**/.turbo\" \"**/dist\" \"**/build\"",
    "docker:landing": "docker-compose up landing",
    "docker:landing:build": "docker-compose build --no-cache landing",
    "docker:landing:rebuild": "docker-compose build landing && docker-compose up landing",
    "docker:landing:logs": "docker-compose logs -f landing",
    "docker:landing:shell": "docker-compose exec landing sh",
    "docker:dev": "docker-compose up -d",
    "docker:stop": "docker-compose stop",
    "docker:down": "docker-compose down",
    "docker:clean": "docker-compose down -v --rmi all",
    "docker:prune": "docker system prune -af --volumes",
    "docker:setup": "node scripts/docker-setup.js",
    "platform:switch": "node scripts/platform-switch.js",
    "platform:clean": "node scripts/platform-switch.js clean",
    "platform:setup": "node scripts/platform-switch.js setup",
    "platform:recover": "node scripts/platform-switch.js recover",
    "platform:check": "node scripts/platform-switch.js check",
    "preinstall": "node -e \"console.log('\\n⚠️  Platform:', process.platform, process.arch, '\\n')\"",
    "safe:install": "pnpm platform:clean && pnpm install",
    "safe:switch": "pnpm platform:switch",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^18.6.3",
    "@playwright/test": "^1.51.1",
    "@types/node": "^20.19.11",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "globals": "^16.4.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.5.2",
    "prettier": "^3.6.2",
    "rimraf": "^5.0.5",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,css,scss}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
