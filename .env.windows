# Windows Development Environment Configuration
# This file is used when developing on Windows machines

# Node environment
NODE_ENV=development

# File watching for Windows (requires polling)
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true
CHOKIDAR_INTERVAL=1000
WATCHPACK_POLL=1000

# Platform indicator
PLATFORM=windows

# Docker settings for Windows
COMPOSE_CONVERT_WINDOWS_PATHS=1
DOCKER_BUILDKIT=1

# Development server
PORT=3000
HOSTNAME=localhost

# Next.js specific
NEXT_TELEMETRY_DISABLED=1

# Optional: API endpoints (customize as needed)
# NEXT_PUBLIC_API_URL=http://localhost:4000
# DATABASE_URL=postgresql://user:pass@localhost:5432/db