# Linux Development Environment Configuration
# This file is used when developing on Linux machines (Ubuntu, Arch, etc.)

# Node environment
NODE_ENV=development

# File watching for Linux (native inotify, no polling needed)
WATCHPACK_POLLING=false
CHOKIDAR_USEPOLLING=false

# Platform indicator
PLATFORM=linux

# Docker settings for Linux (native performance)
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# Development server
PORT=3000
HOSTNAME=localhost

# Next.js specific
NEXT_TELEMETRY_DISABLED=1

# Linux specific optimizations
NODE_OPTIONS=--max-old-space-size=4096

# Optional: API endpoints (customize as needed)
# NEXT_PUBLIC_API_URL=http://localhost:4000
# DATABASE_URL=postgresql://user:pass@localhost:5432/db